(include "src/base.egg")

;;;; StableHLO Dialect ;;;;

;; Types
(datatype Precision (DEFAULT) (HIGH) (HIGHEST))

;; Attrs
(function PrecisionAttr (Precision) Attr)
(function DotDimensionNumbersAttr (IntVec IntVec IntVec IntVec) Attr)
(function DotAlgorithmAttr (Type Type Type i64 i64 i64 bool) Attr)

;; Ops
(function stablehlo_dot_general (Op Op AttrPair Type) Op)
(function stablehlo_concatenate (Op Op AttrPair Type) Op)

;; OPS HERE ;;

;; RULES HERE ;;
(ruleset rules)

(rule ; type-of[v] = v.type
    ((= A (Value ?id ?t)))
    ((set (type-of A) ?t))
    :ruleset rules
)
(rule ; type-of[x] = x.type
    ((= A (stablehlo_dot_general ?x ?y ?a ?t)))
    ((set (type-of A) ?t))
    :ruleset rules
)
(rule ; type-of[x] = x.type
    ((= A (stablehlo_concatenate ?x ?y ?a ?t)))
    ((set (type-of A) ?t))
    :ruleset rules
)

(function nrows (Type) i64)
(function ncols (Type) i64)

(rule ; nrows[t] = t.shape[0]
    ((= T (RankedTensor ?shape ?_)) (>= (vec-length ?shape) 1))
    ((set (nrows T) (vec-get ?shape 0)))
    :ruleset rules
)

(rule ; ncols[t] = t.shape[1]
    ((= T (RankedTensor ?shape ?_)) (>= (vec-length ?shape) 2))
    ((set (ncols T) (vec-get ?shape 1)))
    :ruleset rules
)

(rule ; cost[xy] = nrows(x) * ncols(x) * ncols(y)
    ((stablehlo_dot_general ?x ?y ?a ?t)
     (= a (nrows (type-of ?x)))
     (= b (ncols (type-of ?x)))
     (= c (ncols (type-of ?y))))

    ((unstable-cost (stablehlo_dot_general ?x ?y ?a ?t) (* (* a b) c)))
    :ruleset rules
)

(rule ; cost[x concat y] = nrows(x) * ncols(x) + nrows(y) * ncols(y)
    ((stablehlo_concatenate ?x ?y ?a ?t)
     (= a (nrows (type-of ?x)))
     (= b (ncols (type-of ?x)))
     (= c (nrows (type-of ?y)))
     (= d (ncols (type-of ?y))))

    ((unstable-cost (stablehlo_concatenate ?x ?y ?a ?t) (+ (* a b) (* c d))))
    :ruleset rules
)

(let dim0 (NamedAttr "dimension" (IntegerAttr 0 (I64))))

(rule ; xz 0 yz -> (x 0 y)z where 0 is concatenation on axis 0
    ((= xz (stablehlo_dot_general ?x ?z ?a (RankedTensor ?s1 ?t)))
     (= yz (stablehlo_dot_general ?y ?z ?a (RankedTensor ?s2 ?t)))
     (= xz0yz (stablehlo_concatenate xz yz dim0 ?xz0yz_t))
     (= xr (nrows (type-of ?x)))
     (= xc (ncols (type-of ?x)))
     (= yr (nrows (type-of ?y))))

    ((let x0y (stablehlo_concatenate ?x ?y dim0 (RankedTensor (vec-of (+ xr yr) xc) ?t)))
     (union xz0yz (stablehlo_dot_general x0y ?z ?a ?xz0yz_t)))
    :ruleset rules
)

(rule ; (x 0 y)z -> xz 0 yz where 0 is concatenation on axis 0
    ((= x0y (stablehlo_concatenate ?x ?y dim0 (RankedTensor ?s1 ?t)))
     (= x0y_z (stablehlo_dot_general x0y ?z ?a ?x0y_z_t))
     (= xr (nrows (type-of ?x)))
     (= yr (nrows (type-of ?y)))
     (= zc (ncols (type-of ?z))))

    ((let xz (stablehlo_dot_general ?x ?z ?a (RankedTensor (vec-of xr zc) ?t)))
     (let yz (stablehlo_dot_general ?y ?z ?a (RankedTensor (vec-of yr zc) ?t)))
     (union x0y_z (stablehlo_concatenate xz yz dim0 ?x0y_z_t)))
    :ruleset rules
)

(run-schedule (saturate rules))

